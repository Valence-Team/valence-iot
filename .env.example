# Visão computacional
MODELO_VISAO_PATH=modelos/visao.pt
CONFIANCA_MINIMA=0.6
PORTAO_MODELO=openai/clip-vit-base-patch32

# RAG
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INDICE_PATH=modelos/indice

# LLM principal (Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_chave_ficticia_troque_pela_sua
LLM_MODEL=openai/gpt-oss-20b

# LLM reserva (Gemini, endpoint compatível com OpenAI)
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=chave_gemini_ficticia_troque_pela_sua
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=4

# Segurança e limites
IA_API_KEY=chave_compartilhada_ficticia_com_a_api_java
TAMANHO_MAXIMO_MB=8
DEMO_HABILITADA=true
